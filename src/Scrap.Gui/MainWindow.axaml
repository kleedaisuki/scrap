<?xml version="1.0" ?>
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:Scrap.Gui.ViewModels" xmlns:models="using:Scrap.Gui.Models" x:Class="Scrap.Gui.MainWindow" x:DataType="vm:MainWindowViewModel" mc:Ignorable="d" Width="1180" Height="760" MinWidth="940" MinHeight="620" Icon="avares://Scrap.Gui/Assets/scrap.png" Title="{Binding L.WindowTitle}">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" IsEnabled="{Binding IsWorkspaceEnabled}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="Auto,24,*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="S" Foreground="{DynamicResource OnAccentBrush}" FontFamily="Georgia" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="scrap" Classes="heading" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="{Binding L.Tagline}" Classes="muted" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding L.Scope}" Classes="accent" VerticalAlignment="Center"/>
          <ComboBox Width="220" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" PlaceholderText="{Binding L.ChooseScope}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:ScopeSummary">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding RecordCount}" Classes="muted" Margin="12,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding ScopeStatus}" Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7">
          <Button Content="{Binding L.NewRecord}" Classes="primary" Command="{Binding OpenCreateRecordCommand}"/>
          <Button Content="{Binding L.NewScope}" Command="{Binding OpenCreateScopeCommand}"/>
          <Button Content="{Binding L.Rename}" Command="{Binding OpenRenameScopeCommand}"/>
          <Button Content="{Binding L.Delete}" Classes="danger" Command="{Binding OpenDeleteScopeCommand}"/>
          <ComboBox Width="106" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:CompileBindings="False">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Width="108" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:CompileBindings="False">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="1" IsEnabled="{Binding IsWorkspaceEnabled}" Margin="24,16,24,12" Spacing="8">
      <Border Classes="panel" Padding="14">
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
          <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="16" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding L.SearchPlaceholder}" IsEnabled="{Binding HasSelectedScope}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0" Spacing="3" VerticalAlignment="Center">
            <RadioButton GroupName="SearchMode" Classes="mode" Content="{Binding L.Exact}" IsChecked="{Binding IsExactMode}"/>
            <RadioButton GroupName="SearchMode" Classes="mode" Content="{Binding L.Fuzzy}" IsChecked="{Binding IsFuzzyMode}"/>
            <RadioButton GroupName="SearchMode" Classes="mode" Content="{Binding L.Regex}" IsChecked="{Binding IsRegexMode}"/>
            <CheckBox Content="Aa" IsChecked="{Binding CaseSensitive}" Margin="8,0,0,0" ToolTip.Tip="{Binding L.CaseSensitive}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="{Binding L.SearchIn}" Classes="muted" VerticalAlignment="Center"/>
            <Button x:Name="SearchScopeButton" Width="180" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding SearchScopeAccessibleName}" ToolTip.Tip="{Binding SearchScopeSummary}">
              <Button.Content>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SearchScopeSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="⌄" Classes="muted" Margin="10,0,0,0"/>
                </Grid>
              </Button.Content>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="280" Spacing="8">
                    <TextBlock Text="{Binding L.ChooseSearchScopes}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding L.SearchScopesHint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    <RadioButton GroupName="SearchScopeCoverage" Content="{Binding L.AllScopes}" IsChecked="{Binding IsAllSearchScopesSelected}"/>
                    <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding SearchScopeChoices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SearchScopeChoice">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3" AutomationProperties.Name="{Binding Name}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SearchError}" Foreground="{DynamicResource DangerBrush}" Margin="4,8,4,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Border IsVisible="{Binding HasError}" Background="{DynamicResource AccentWashBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel>
            <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ErrorMessage}" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding L.Retry}" Command="{Binding RetryCommand}" Margin="8,0"/>
          <Button Grid.Column="2" Content="×" Command="{Binding DismissErrorCommand}"/>
        </Grid>
      </Border>
    </StackPanel>
    <Grid Grid.Row="2" IsEnabled="{Binding IsWorkspaceEnabled}" Margin="24,0,24,24" ColumnDefinitions="370,14,*">
      <Border Grid.Column="0" Classes="panel" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="8,4,8,10">
            <StackPanel>
              <TextBlock Text="{Binding L.Candidates}" Classes="accent" FontSize="12"/>
              <TextBlock Text="{Binding L.CandidatesHint}" Classes="muted" FontSize="11"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <ListBox x:Name="CandidateList" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:RecordCandidate">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Key}" FontFamily="IBM Plex Mono,Cascadia Mono,Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="10" Padding="7,3" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Scope}" Classes="muted" FontSize="10"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding HasNoScopes}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9" Margin="20">
              <TextBlock Text="♡" Foreground="{DynamicResource AccentBrush}" FontSize="34" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding L.NoScopesTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding L.NoScopesBody}" Classes="muted" TextAlignment="Center"/>
              <Button Content="{Binding L.CreateFirstScope}" Classes="primary" Command="{Binding OpenCreateScopeCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasNoCandidates}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="20">
              <TextBlock Text="{Binding L.NoCandidates}" Classes="muted" HorizontalAlignment="Center"/>
              <Button Content="{Binding L.CreateRecord}" Command="{Binding OpenCreateRecordCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
            <ProgressBar IsVisible="{Binding IsSearching}" IsIndeterminate="True" VerticalAlignment="Top" Height="2" Foreground="{DynamicResource AccentBrush}"/>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Classes="panel">
        <Grid>
          <StackPanel IsVisible="{Binding HasNoSelectedRecord}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="✧" Foreground="{DynamicResource AccentStrongBrush}" FontSize="40" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding L.ChooseKey}" Classes="heading" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding L.ChooseKeyHint}" Classes="muted" TextAlignment="Center"/>
          </StackPanel>
          <ProgressBar IsVisible="{Binding IsLoadingRecord}" IsIndeterminate="True" Width="180" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Grid IsVisible="{Binding HasSelectedRecord}" RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding L.SelectedRecord}" Classes="accent" FontSize="12"/>
                <TextBlock Text="{Binding RecordIdentity}" Classes="heading" FontFamily="IBM Plex Mono,Cascadia Mono,Consolas,monospace" FontSize="20" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding UpdatedText}" Classes="muted" FontSize="11" Margin="0,5,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource AccentWashBrush}" CornerRadius="10" Padding="10,5" VerticalAlignment="Top">
                <TextBlock Text="{Binding L.LocalOnly}" Foreground="{DynamicResource AccentStrongBrush}" FontSize="11"/>
              </Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding L.Value}" Classes="muted" FontSize="11" Margin="0,28,0,8"/>
            <Border Grid.Row="2" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding DisplayValues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:RecordValueDisplay">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Position}" Classes="muted" FontSize="11" Margin="0,3,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="IBM Plex Mono,Cascadia Mono,Consolas,monospace" FontSize="15" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L.Copy}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyValueCommand}" CommandParameter="{Binding}" Margin="12,0,0,0"/>
                        <Button Grid.Column="3" Content="{Binding RevealButtonText}" IsVisible="{Binding IsMasked}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleRevealValueCommand}" CommandParameter="{Binding}" Margin="8,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding L.Copy}" Classes="primary" Command="{Binding CopyCommand}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding L.Edit}" Command="{Binding OpenEditRecordCommand}"/>
                <Button Content="{Binding L.Delete}" Classes="danger" Command="{Binding OpenDeleteRecordCommand}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.RowSpan="3" IsVisible="{Binding IsScopeEditorOpen}" Background="{DynamicResource OverlayBrush}" ZIndex="20">
      <Border Classes="panel" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding ScopeEditorTitle}" Classes="heading" FontSize="20"/>
          <TextBlock Text="{Binding L.ScopeNameHint}" Classes="muted" TextWrapping="Wrap"/>
          <TextBox x:Name="ScopeNameBox" Text="{Binding ScopeNameInput}" PlaceholderText="{Binding L.ScopeName}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding L.Cancel}" Command="{Binding CloseModalCommand}" IsCancel="True"/>
            <Button Content="{Binding L.Save}" Classes="primary" Command="{Binding SaveScopeCommand}" IsDefault="True"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" IsVisible="{Binding IsScopeDeleteOpen}" Background="{DynamicResource OverlayBrush}" ZIndex="20">
      <Border Classes="panel" Width="510" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding L.DeleteScopeTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
          <TextBlock Text="{Binding ScopeDeleteMessage}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding L.DeleteScopeHint}" Classes="muted" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ScopeDeleteCancelButton" Content="{Binding L.Cancel}" Command="{Binding CloseModalCommand}" IsCancel="True"/>
            <Button x:Name="ScopeDeleteConfirmButton" Content="{Binding L.DeleteExactScope}" Classes="danger" Command="{Binding ConfirmDeleteScopeCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" IsVisible="{Binding IsRecordEditorOpen}" Background="{DynamicResource OverlayBrush}" ZIndex="20">
      <Border Classes="panel" Width="630" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="13">
          <TextBlock Text="{Binding RecordEditorTitle}" Classes="heading" FontSize="20"/>
          <TextBlock Text="{Binding L.KeyLabel}" Classes="muted" FontSize="11"/>
          <TextBox x:Name="RecordKeyBox" Text="{Binding EditorKey}" IsReadOnly="{Binding IsEditorKeyReadOnly}" PlaceholderText="{Binding L.KeyPlaceholder}"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding L.ValueLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="{Binding L.ShowWhileEditing}" IsChecked="{Binding EditorValueVisible}"/>
          </Grid>
          <ScrollViewer MinHeight="180" MaxHeight="330" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RecordValuesHost" ItemsSource="{Binding EditorValues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:RecordValueEditor">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Position, StringFormat='Value {0}'}" Classes="muted" FontSize="11" Margin="0,12,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Value}" AcceptsReturn="True" TextWrapping="Wrap" PasswordChar="●" RevealPassword="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditorValueVisible}" MinHeight="92" FontFamily="IBM Plex Mono,Cascadia Mono,Consolas,monospace" FontSize="15" Padding="12,10,20,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding AccessibleName}"/>
                    <Button Grid.Column="2" Content="↑" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveEditorValueUpCommand}" CommandParameter="{Binding}" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L.MoveValueUp}"/>
                    <Button Grid.Column="3" Content="↓" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveEditorValueDownCommand}" CommandParameter="{Binding}" Margin="4,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L.MoveValueDown}"/>
                    <Button Grid.Column="4" Content="−" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveEditorValueCommand}" CommandParameter="{Binding}" Margin="4,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).L.RemoveValue}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding L.SaveRecordShortcutHint}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{Binding L.AddValue}" Command="{Binding AddEditorValueCommand}"/>
          </Grid>
          <TextBlock Text="{Binding EditorValuesValidationMessage}" IsVisible="{Binding HasEditorValuesValidationError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
          <Border Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="10" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding L.DefaultDisplay}" FontWeight="SemiBold"/>
              <RadioButton GroupName="RecordPresentation" IsChecked="{Binding EditorIsMasked}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="2" Margin="8,0,0,0">
                  <TextBlock Text="{Binding L.MaskedTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding L.MaskedHint}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="RecordPresentation" IsChecked="{Binding EditorIsPlain}" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="2" Margin="8,0,0,0">
                  <TextBlock Text="{Binding L.VisibleTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding L.VisibleHint}" Classes="muted"/>
                </StackPanel>
              </RadioButton>
              <TextBlock Text="{Binding L.EncryptionInvariant}" Classes="muted" FontStyle="Italic"/>
            </StackPanel>
          </Border>
          <Border IsVisible="{Binding HasError}" Background="{DynamicResource AccentWashBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
            <StackPanel>
              <TextBlock Text="{Binding ErrorTitle}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ErrorMessage}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding L.Cancel}" Command="{Binding CloseModalCommand}" IsCancel="True"/>
            <Button Content="{Binding L.SaveRecord}" Classes="primary" Command="{Binding SaveRecordCommand}" IsDefault="True" ToolTip.Tip="{Binding L.SaveRecordShortcutHint}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" IsVisible="{Binding IsRecordDeleteOpen}" Background="{DynamicResource OverlayBrush}" ZIndex="20">
      <Border Classes="panel" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding L.DeleteRecordTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
          <TextBlock Text="{Binding RecordDeleteMessage}" TextWrapping="Wrap" FontFamily="IBM Plex Mono,Cascadia Mono,Consolas,monospace"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="RecordDeleteCancelButton" Content="{Binding L.Cancel}" Command="{Binding CloseModalCommand}" IsCancel="True"/>
            <Button x:Name="RecordDeleteConfirmButton" Content="{Binding L.DeleteExactRecord}" Classes="danger" Command="{Binding ConfirmDeleteRecordCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="3" IsVisible="{Binding HasToast}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20" ZIndex="30">
      <TextBlock Text="{Binding ToastMessage}" FontWeight="SemiBold"/>
    </Border>
  </Grid>
</Window>
